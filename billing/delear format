<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tax Invoice - {{ doc.company_name }}</title>
    


    <style>
        
        .items-table tr {
            page-break-inside: avoid !important;
        }
        .items-table thead {
            display: table-header-group;
        }
        .page-break {
            page-break-after: always;
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <div class="invoice-header">
            <h2>TAX INVOICE</h2>
            <span class="company-name">{{ doc.company_name }}</span>
            <div class="company-address">{{ doc.company_address }}, {{ doc.company_city }}, {{ doc.company_state }}-{{ doc.company_pincode }}</div>
            <div class="gstin-badge">GSTIN : {{ doc.company_gst_no }}</div>
        </div>

        <div class="invoice-body">
            <table class="details-table">
                <tr>
                    <th width="20%">Invoice No.</th>
                    <td width="30%">{{ doc.name }}</td>
                    <th width="20%">GR/RR No.</th>
                    <td width="30%">{{ doc.gr_rr_no or '-' }}</td>
                </tr>
                <tr>
                    <th>Dated</th>
                    <td>{{ frappe.format_date(doc.invoice_date) }}</td>
                    <th>Transport</th>
                    <td>{{ doc.transport or '-' }}</td>
                </tr>
                <tr>
                    <th>Place of Supply</th>
                    <td>{{ doc.state }} {{ '(' + doc.state_code + ')' if doc.state_code else '' }}</td>
                    <th>Vehicle No.</th>
                    <td>{{ doc.vehicle_no or '-' }}</td>
                </tr>
                <tr>
                    <th>Reverse Charge</th>
                    <td>{{ doc.reverse_charge or 'N' }}</td>
                    <th>Station</th>
                    <td>{{ doc.station or '-' }}</td>
                </tr>
            </table>

            <div class="billed-to-container">
                <div class="billed-to-box">
                    <h3>Buyer (Bill to)</h3>
                    <div class="text-bold">{{ doc.party_name }}</div>
                    <div>{{ doc.billed_to_address }}</div>
                    <div>{{ doc.landmark }}</div>
                    <div style="margin-top: 10px;">
                        <div>City: {{ doc.city or '' }}</div>
                        <div>State: {{ doc.state }} {{ '(' + doc.state_code + ')' if doc.state_code else '' }}</div>
                        <div>Pincode: {{ doc.pincode or '' }}</div>
                        <div>GSTIN: {{ doc.gst_no or '' }}</div>
                        
                    </div>
                </div>
                <div class="billed-to-box">
                    <h3>Consignee (Ship to)</h3>
                    <div class="text-bold">{{ doc.shipping_customer_name or doc.party_name }}</div>
                    <div>{{ doc.shipped_to_address or doc.billed_to_address }}</div>
                    <div>{{ doc.landmark }}</div>
                    <div style="margin-top: 10px;">
                        <div>City: {{ doc.city or '' }}</div>
                        <div>State: {{ doc.shipping_state or doc.state }} {{ '(' + (doc.shipping_state_code or doc.state_code) + ')' if (doc.shipping_state_code or doc.state_code) else '' }}</div>
                        <div>Pincode: {{ doc.shipping_pincode or doc.pincode }}</div>
                        <div>GSTIN: {{ doc.shipping_gstin or doc.gstin or doc.gst_no }}</div>
                    </div>
                </div>
            </div>

            <table class="items-table">
                <thead>
                    <tr>
                        <th width="6%">S.N.</th>
                        <th width="35%">Description of Goods</th>
                        <th width="10%">HSN/SAC</th>
                        <th width="6%">Qty.</th>
                        <th width="6%">Unit</th>
                        
                        <th width="12%">Rate (₹)</th>
                        <th width="15%">Amount (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in doc.items %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>
                            <span class="product-name">{{ item.item_name }}</span>
                            {% if item.description %} - {{ item.description }}{% endif %}
                        </td>
                        <td>{{ item.hsn_code or '' }}</td>
                        <td>{{ item.quantity }}</td>
                        <td>{{ item.uom or 'Nos.' }}</td>
                        
                        <td class="text-right">{{ frappe.format_value(item.rate, {'fieldtype': 'Currency'}) }}</td>
                        <td class="text-right">{{ frappe.format_value(item.rate * item.quantity, {'fieldtype': 'Currency'}) }}</td>
                    </tr>

                    {% if loop.index == 13 %}
                    </tbody>
                </table>

                <!-- Page break here -->
                <div class="page-break"></div>

                <!-- Restart the table -->
                <table class="items-table">
                    <thead>
                        <tr>
                            <th width="6%">S.N.</th>
                            <th width="35%">Description of Goods</th>
                            <th width="10%">HSN/SAC</th>
                            <th width="6%">Qty.</th>
                            <th width="6%">Unit</th>
                            
                            <th width="12%">Rate (₹)</th>
                            <th width="15%">Amount (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% endif %}
                    {% endfor %}
                    <tr class="highlight-row">
                        <td colspan="3" class="text-bold">Totals c/o</td>
                        <td class="text-bold">{{ doc.billed_quantity }}</td>
                        <td class="text-bold">{{ doc.uom or 'Nos.' }}</td>
                        <td colspan="1"></td>
                        <td class="text-right text-bold">{{ frappe.format_value(doc.pre_discount_taxable_value or doc.invoice_amount, {'fieldtype': 'Currency'}) }}</td>
                    </tr>
                </tbody>
            </table>
            <div class="total-section">
                {% if doc.total_discount %}
                <div class="total-row">
                    <span>Less: discount </span>
                    <span class="text-bold">{{ frappe.format_value(doc.total_discount / (1 + (doc.gst_slab or 0) / 100), {'fieldtype': 'Currency'}) }}</span>

                </div>
                {% endif %}
                
                {% if doc.total_discount %}
                <div class="total-row">
                    <span>Sub Total: </span>
                    <span class="text-bold">{{ frappe.format_value(doc.taxable_amount, {'fieldtype': 'Currency'}) }}</span>

                </div>
                {% endif %}
                
                {% if doc.state_code == "27" %}
                    <div class="total-row">
                        <span>Add: SGST @ {{ doc.gst_slab/2 }}%</span>
                        <span class="text-bold">{{ frappe.format_value(doc.sgst_amount, {'fieldtype': 'Currency'}) }}</span>
                    </div>
                    <div class="total-row">
                        <span>Add: CGST @ {{ doc.gst_slab/2 }}%</span>
                        <span class="text-bold">{{ frappe.format_value(doc.cgst_amount, {'fieldtype': 'Currency'}) }}</span>
                    </div>
                {% else %}
                    <div class="total-row">
                        <span>Add: IGST @ {{ doc.gst_slab }}%</span>
                        <span class="text-bold">{{ frappe.format_value(doc.igst_amount, {'fieldtype': 'Currency'}) }}</span>
                    </div>
                {% endif %}
                
                {% if (doc.grand_total_amount - doc.rounded_total_amount)|round(2) != 0.00 %}
                <div class="total-row">
                    <span>Rounding Adjustment</span>
                    <span class="text-bold">{{ frappe.format_value(doc.grand_total_amount - doc.rounded_total_amount, {'fieldtype': 'Currency'}) }}</span>
                </div>
                {% endif %}
                
                <div class="total-row grand-total">
                    <span>Grand Total</span>
                    <span>{{ frappe.format_value(doc.rounded_total_amount, {'fieldtype': 'Currency'}) }}</span>
                </div>
            </div>
            
            <div class="tax-breakup">
                <table class="items-table" style="margin-top: 10px;">
                    <thead>
                        <tr>
                            <th>Tax Rate</th>
                            <th>Taxable Amount (₹)</th>
                            <th>Tax Amount (₹)</th>
                            <th>Total Tax (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if doc.state_code == "27" %}
                            <tr>
                                <td>SGST @ {{ doc.gst_slab/2 }}%</td>
                                <td>{{ frappe.format_value(doc.taxable_amount or 0, {'fieldtype': 'Currency'}) }}</td>
                                <td>{{ frappe.format_value(doc.sgst_amount, {'fieldtype': 'Currency'}) }}</td>
                                <td>{{ frappe.format_value(doc.sgst_amount, {'fieldtype': 'Currency'}) }}</td>
                            </tr>
                            <tr>
                                <td>CGST @ {{ doc.gst_slab/2 }}%</td>
                                <td>{{ frappe.format_value(doc.taxable_amount or 0, {'fieldtype': 'Currency'}) }}</td>
                                <td>{{ frappe.format_value(doc.cgst_amount, {'fieldtype': 'Currency'}) }}</td>
                                <td>{{ frappe.format_value(doc.cgst_amount, {'fieldtype': 'Currency'}) }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td>IGST @ {{ doc.gst_slab }}%</td>
                                <td>{{ frappe.format_value(doc.taxable_amount or 0, {'fieldtype': 'Currency'}) }}</td>
                                <td>{{ frappe.format_value(doc.igst_amount, {'fieldtype': 'Currency'}) }}</td>
                                <td>{{ frappe.format_value(doc.igst_amount, {'fieldtype': 'Currency'}) }}</td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
            
            <div class="amount-in-words">
                <span class="text-bold">Amount in Words:</span> {{ frappe.utils.money_in_words(doc.grand_total_amount) }}
            </div>
            
            <div class="signature-section">
                This is System generated slip from 
                <a href="https://mebikeindia.com" target="_blank" rel="noopener noreferrer" class="url-name">mebikeindia</a>. No need of signature.
            </div>
        </div>
    </div>
</body>
</html>

